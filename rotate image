class Solution:
    def rotate(self, matrix: List[List[int]]) -> None:
        n = len(matrix)
        for i in range(n):
            for j in range(i + 1, n):
                temp = matrix[i][j]
                matrix[i][j] = matrix[j][i]
                matrix[j][i] = temp
        for i in range(n):
            a = 0
            b = n - 1
            while a < b:
                temp = matrix[i][a]
                matrix[i][a] = matrix[i][b]
                matrix[i][b] = temp
                a += 1
                b -= 1
